          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "spec": {
                        "query": "from(bucket: \"energy_meters\")\r\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\r\n  |> filter(fn: (r) => r[\"_measurement\"] == \"energy-meters\" or r[\"_measurement\"] == \"smart-plugs\")\r\n  |> filter(fn: (r) => r[\"_field\"] == \"pActive\" or r[\"_field\"] == \"power\")\r\n  |> filter(fn: (r) => r[\"deviceId\"] == \"001\" or r[\"deviceId\"] == \"002\")\r\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
